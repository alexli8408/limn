# ---------------------------------------------------------------------------
# Supabase: Project Settings > Data API
# ---------------------------------------------------------------------------
# Safe to expose: the anon key only ever acts through RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Fallback origin only. Share links and the OAuth redirect are built from the
# host the request actually arrived on, so a link copied from localhost:3001
# points at localhost:3001 rather than at whatever this says. Still worth setting
# for the few places with no request in scope.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Gemini: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Chosen by scripts/bench-gemini.py, not by reading model numbers. Over 3 runs
# each on the app's real prompts and schema:
#   gemini-3.6-flash       9/9 correct, 8313ms median, 0 errors   <- default
#   gemini-3.1-flash-lite  9/9 correct, 4932ms median, 0 errors
#   gemini-3.5-flash       8/9 correct, 6419ms median, one 429
#   gemini-3.7-flash       4/9 correct, five 503s (oversubscribed)
# Pinned, not gemini-flash-latest: the alias tracks whatever is newest, which is
# also whatever is busiest, and it 503'd repeatedly. gemini-2.5-* are withdrawn
# for new API keys entirely.
GEMINI_MODEL=gemini-3.6-flash
# The "higher quality" toggle. Pro returns 429 on the free tier, and the client
# falls back to GEMINI_MODEL automatically when it does, so leaving this pointed
# at Pro costs one wasted round trip on a free key and upgrades for free on a
# paid one. The panel reports which model actually answered.
GEMINI_MODEL_PRO=gemini-pro-latest

# ---------------------------------------------------------------------------
# Vision service (apps/vision, deployed to Render)
# ---------------------------------------------------------------------------
VISION_SERVICE_URL=http://localhost:8000
# Shared secret. Must match VISION_API_KEY on the Render service. Generate with:
#   openssl rand -hex 32
VISION_API_KEY=

# ---------------------------------------------------------------------------
# Vision service's own environment (set these on Render, not here)
# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# OPENCV_THREADS=2
# LOG_LEVEL=INFO
