# ---------------------------------------------------------------------------
# Supabase: Project Settings > Data API
# ---------------------------------------------------------------------------
# Safe to expose: the anon key only ever acts through RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Absolute origin, used to build share links. Vercel sets this per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Gemini: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Pinned, not gemini-flash-latest. The alias tracks whatever is newest, which is
# also whatever is busiest: it returned 503 repeatedly while the pinned models
# answered fine. gemini-2.5-* are gone, refused for new API keys.
GEMINI_MODEL=gemini-3.5-flash
# The "higher quality" toggle. Not a Pro model by default: Pro returns 429 on the
# free tier. On a paid key, gemini-pro-latest is the upgrade.
GEMINI_MODEL_PRO=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Vision service (apps/vision, deployed to Render)
# ---------------------------------------------------------------------------
VISION_SERVICE_URL=http://localhost:8000
# Shared secret. Must match VISION_API_KEY on the Render service. Generate with:
#   openssl rand -hex 32
VISION_API_KEY=

# ---------------------------------------------------------------------------
# Vision service's own environment (set these on Render, not here)
# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# OPENCV_THREADS=2
# LOG_LEVEL=INFO
